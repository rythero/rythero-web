---
import { lessons } from '../data/lessons.js';

const { lessonKey, lang = 'en' } = Astro.props;
const locale = ['en','es','pt-br'].includes(lang) ? lang : 'en';
const lesson = lessons[lessonKey];
if (!lesson) throw new Error(`Unknown lesson: ${lessonKey}`);
const t = lesson[locale];
const base = locale === 'en' ? '' : `/${locale}`;
const promptHref = `${base}/tools/prompt-builder`;
const studioHref = `${base}/tools/song-studio`;
const signatureHref = `${base}/tools/signature-lab`;
const schoolHref = `${base}/learn`;
const secondHref = lessonKey === 'styleDna' ? signatureHref : promptHref;
const relatedHref = lessonKey === 'styleDna' ? `${base}/learn/bpm-key-energy` : lessonKey === 'bpmKeyEnergy' ? `${base}/learn/suno-v6` : schoolHref;
const promptBuilderLabel = locale === 'es' ? 'Generador de prompts' : locale === 'pt-br' ? 'Gerador de prompts' : 'Prompt Builder';
---

<article class="shell lesson-page">
  <header class="lesson-hero">
    <div class="eyebrow">{t.eyebrow}</div>
    <h1>{t.title}</h1>
    <p class="dek">{t.dek}</p>
  </header>

  <section class="quick-card">
    <div class="eyebrow">{t.quickTitle}</div>
    <p>{t.quick}</p>
  </section>

  <div class="lesson-body">
    {t.sections.map((section) => (
      <section class="lesson-section">
        <h2>{section.title}</h2>
        {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
        {section.example && (
          <div class="example-grid">
            <div class="example weak"><span>{section.example.weakLabel}</span><p>{section.example.weak}</p></div>
            <div class="example strong"><span>{section.example.strongLabel}</span><p>{section.example.strong}</p></div>
          </div>
        )}
      </section>
    ))}

    <section class="takeaway">
      <div class="eyebrow">{t.takeawayTitle}</div>
      <p>{t.takeaway}</p>
    </section>

    <section class="tool-card">
      <div>
        <div class="eyebrow">{t.ctaTitle}</div>
        <h2>{t.ctaText.replaceAll('Prompt Builder', promptBuilderLabel)}</h2>
      </div>
      <div class="tool-actions">
        <a class="pill primary" href={studioHref}>{t.studio}</a>
        <a class="pill" href={secondHref}>{t.signature.replaceAll('Prompt Builder', promptBuilderLabel)}</a>
      </div>
    </section>

    <section class="faq-block">
      <div class="eyebrow">{t.faqTitle}</div>
      <div class="faq-list">
        {t.faqs.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>

    <section class="sources-block">
      <div class="eyebrow">{t.sourcesTitle}</div>
      <ul>{t.sources.map(([label,url]) => <li><a href={url} rel="nofollow noopener noreferrer">{label} ↗</a></li>)}</ul>
      <p class="updated">{t.updated}</p>
    </section>

    <nav class="lesson-nav" aria-label="Lesson navigation">
      <a href={schoolHref}>← {locale === 'es' ? 'Todas las lecciones' : locale === 'pt-br' ? 'Todas as aulas' : 'All lessons'}</a>
      <a href={relatedHref}>{t.related} →</a>
    </nav>
  </div>
</article>

<style>
  .lesson-page{max-width:980px;padding-bottom:90px}.lesson-hero{padding:72px 0 34px}.lesson-hero h1{font-size:clamp(3rem,7vw,6.1rem);line-height:.93;letter-spacing:-.06em;margin:14px 0 24px;max-width:940px}.dek{font-size:clamp(1.08rem,2vw,1.32rem);line-height:1.65;color:var(--muted);max-width:800px}.quick-card{border:1px solid rgba(102,255,140,.25);background:linear-gradient(145deg,#0c1810,#08100b);border-radius:24px;padding:25px 28px;margin:10px 0 50px}.quick-card p{font-size:1.12rem;line-height:1.72;margin:12px 0 0}.lesson-body{max-width:820px}.lesson-section{padding:34px 0;border-top:1px solid var(--line)}.lesson-section h2{font-size:clamp(1.7rem,3.5vw,2.55rem);line-height:1.05;letter-spacing:-.035em;margin:0 0 18px}.lesson-section p,.lesson-section li{font-size:1.04rem;line-height:1.78;color:#c5cec8}.lesson-section p{margin:0 0 16px}.lesson-section ul{padding-left:22px;margin:16px 0 0}.lesson-section li{margin:8px 0}.example-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:24px}.example{border:1px solid var(--line);border-radius:18px;padding:18px;background:#090f0b}.example span{display:block;font-size:.68rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase;color:#76857c;margin-bottom:8px}.example p{margin:0;font-size:.97rem;line-height:1.65}.example.strong{border-color:#31583d;background:#0a130d}.example.strong span{color:var(--green)}.takeaway{margin:28px 0 52px;padding:24px 26px;border-left:3px solid var(--green);background:#09100c;border-radius:0 18px 18px 0}.takeaway p{font-size:1.12rem;line-height:1.7;margin:10px 0 0}.tool-card{border:1px solid var(--line);border-radius:24px;padding:26px;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;background:linear-gradient(145deg,#0d1611,#080d0a);margin:42px 0 56px}.tool-card h2{font-size:1.2rem;line-height:1.55;margin:10px 0 0;font-weight:600;color:#c8d2cb;max-width:590px}.tool-actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end}.faq-block{padding-top:12px}.faq-list{margin-top:16px;border-top:1px solid var(--line)}.faq-list details{border-bottom:1px solid var(--line);padding:16px 0}.faq-list summary{cursor:pointer;font-weight:750;font-size:1.03rem}.faq-list p{color:var(--muted);line-height:1.7;margin:12px 0 2px;max-width:730px}.sources-block{padding:48px 0 22px}.sources-block ul{list-style:none;padding:0;margin:14px 0}.sources-block li{margin:8px 0}.sources-block a{color:#9bdbaa;text-decoration:underline;text-underline-offset:3px}.updated{color:#6f7c74;font-size:.82rem;margin-top:18px}.lesson-nav{display:flex;justify-content:space-between;gap:18px;padding-top:28px;border-top:1px solid var(--line);font-weight:750;color:#a9bbb0}.lesson-nav a:hover{color:var(--green)}@media(max-width:760px){.lesson-hero{padding-top:46px}.quick-card{padding:21px}.example-grid{grid-template-columns:1fr}.tool-card{grid-template-columns:1fr}.tool-actions{justify-content:flex-start}.lesson-nav{flex-direction:column}}
</style>
