---
import { lessonsV2 } from '../data/lessons-v2.js';
const { lang = 'en' } = Astro.props;
const locale = ['en','es','pt-br'].includes(lang) ? lang : 'en';
const base = locale === 'en' ? '' : `/${locale}`;
const bySlug = Object.fromEntries(lessonsV2.map(l => [l.slug, l]));
const t = {
  en:{eyebrow:'AI MUSIC CREATOR SCHOOL',title:'Start from zero. Fix what comes next.',intro:'One school for two moments: making your first complete song and solving the problems that appear after you already know how to generate music.',startPath:'I am starting from zero',startPathText:'Follow a short path from idea → structure → lyrics → first complete draft.',improvePath:'I already make music',improvePathText:'Go straight to repetition, groove, vocals, prompts, arrangement and finishing.',start:'START HERE · FIRST SONG',startIntro:'Learn the minimum you need to finish, not a dictionary of production terms.',improve:'IMPROVE · SOLVE REAL PROBLEMS',improveIntro:'Use these when your songs are technically generated but still do not feel finished or distinct.',tools:'TOOLS · REFERENCES · RELEASE',toolsIntro:'Choose generators more carefully, use reference audio responsibly and check the practical rights chain before publishing.',read:'Read →',studio:'Open Rythero Studio',prompt:'Open Prompt Builder',toolBox:'Learn, then do it immediately',toolText:'The school explains the decision. Rythero tools help you apply it without turning the process into a technical course.',toolsHeading:'Choose, compare and release with more context.'},
  es:{eyebrow:'ESCUELA DE CREADORES · AI MUSIC',title:'Empieza desde cero. Soluciona lo que viene después.',intro:'Una escuela para dos momentos: crear tu primera canción completa y resolver los problemas que aparecen cuando ya sabes generar música.',startPath:'Empiezo desde cero',startPathText:'Sigue un camino corto desde idea → estructura → letra → primer borrador completo.',improvePath:'Ya hago música',improvePathText:'Ve directamente a repetición, groove, voces, prompts, arreglo y acabado.',start:'EMPIEZA AQUÍ · PRIMERA CANCIÓN',startIntro:'Aprende lo mínimo que necesitas para terminar, no un diccionario de producción.',improve:'MEJORA · SOLUCIONA PROBLEMAS REALES',improveIntro:'Úsalas cuando ya consigues canciones, pero todavía no suenan terminadas o diferentes entre sí.',tools:'HERRAMIENTAS · REFERENCIAS · PUBLICACIÓN',toolsIntro:'Elige mejor el generador, usa referencias con criterio y revisa la cadena práctica de derechos antes de publicar.',read:'Leer →',studio:'Abrir Rythero Studio',prompt:'Abrir Prompt Builder',toolBox:'Aprende y aplícalo en el momento',toolText:'La escuela explica la decisión. Las herramientas de Rythero te ayudan a aplicarla sin convertir el proceso en un curso técnico.',toolsHeading:'Elige, compara y publica con más criterio.'},
  'pt-br':{eyebrow:'ESCOLA DE CRIADORES · AI MUSIC',title:'Comece do zero. Resolva o que vem depois.',intro:'Uma escola para dois momentos: fazer sua primeira música completa e resolver os problemas que aparecem quando você já sabe gerar música.',startPath:'Estou começando do zero',startPathText:'Siga um caminho curto: ideia → estrutura → letra → primeiro rascunho completo.',improvePath:'Eu já faço música',improvePathText:'Vá direto para repetição, groove, vozes, prompts, arranjo e acabamento.',start:'COMECE AQUI · PRIMEIRA MÚSICA',startIntro:'Aprenda o mínimo necessário para terminar, não um dicionário de produção.',improve:'MELHORE · RESOLVA PROBLEMAS REAIS',improveIntro:'Use quando você já consegue gerar músicas, mas elas ainda não parecem prontas ou diferentes entre si.',tools:'FERRAMENTAS · REFERÊNCIAS · LANÇAMENTO',toolsIntro:'Escolha melhor o gerador, use referências com responsabilidade e confira a cadeia prática de direitos antes de publicar.',read:'Ler →',studio:'Abrir Rythero Studio',prompt:'Abrir Prompt Builder',toolBox:'Aprenda e aplique na hora',toolText:'A escola explica a decisão. As ferramentas do Rythero ajudam você a aplicar sem transformar o processo em curso técnico.',toolsHeading:'Escolha, compare e lance com mais critério.'}
}[locale];
const existing = {
  prompts:{number:'01',slug:'ai-music-prompts',en:['AI Music Prompts: a producer’s framework for better songs','Build prompts from musical decisions instead of adjective piles.'],es:['Prompts para música con IA: un método de productor para mejores canciones','Construye prompts desde decisiones musicales en vez de acumular adjetivos.'],'pt-br':['Prompts para música com IA: um método de produtor','Monte prompts com decisões musicais em vez de empilhar adjetivos.']},
  structure:{number:'02',slug:'ai-song-structure',en:['Song structure: hooks, verses, choruses and transitions','Understand what each section must do and how contrast keeps attention.'],es:['Estructura: hook, versos, estribillos y transiciones','Entiende qué debe hacer cada sección y cómo el contraste mantiene la atención.'],'pt-br':['Estrutura: hook, versos, refrões e transições','Entenda a função de cada seção e como o contraste mantém a atenção.']},
  style:{number:'03',slug:'style-dna',en:['Style DNA without artist imitation','Build a reusable identity from groove, texture, harmony, voice and production.'],es:['Style DNA sin imitar artistas','Construye una identidad reutilizable desde groove, textura, armonía, voz y producción.'],'pt-br':['Style DNA sem imitar artistas','Crie uma identidade reutilizável com groove, textura, harmonia, voz e produção.']},
  bpm:{number:'04',slug:'bpm-key-energy',en:['BPM, key and energy','Use tempo, tonal direction and energy without turning the prompt into a spreadsheet.'],es:['BPM, tonalidad y energía','Usa tempo, dirección tonal y energía sin convertir el prompt en una hoja de cálculo.'],'pt-br':['BPM, tonalidade e energia','Use andamento, direção tonal e energia sem transformar o prompt em planilha.']},
  suno:{number:'05',slug:'suno-v6',en:['Suno v6: what changed','A practical guide to the current v6 family and its creation workflow.'],es:['Suno v6: qué ha cambiado','Guía práctica de la familia v6 actual y su flujo de creación.'],'pt-br':['Suno v6: o que mudou','Guia prático da família v6 atual e do fluxo de criação.']}
};
const item = (obj) => ({number:obj.number,slug:obj.slug,title:obj[locale][0],text:obj[locale][1]});
const v2 = (slug) => { const l=bySlug[slug]; return {number:l.number,slug,title:l[locale].title,text:l[locale].dek}; };
const startItems=[v2('first-song-workflow'),item(existing.prompts),item(existing.structure),v2('lyrics-that-sing')];
const improveItems=[item(existing.style),item(existing.bpm),v2('pocket-groove-evolution'),v2('stop-songs-sounding-the-same'),v2('vocal-direction-pronunciation'),v2('prompt-debugging'),v2('finish-ai-song')];
const toolItems=[item(existing.suno),v2('ai-music-generators-2026'),v2('reference-audio-workflow'),v2('rights-release-checklist')];
---
<section class="shell school-hero">
  <div class="eyebrow">{t.eyebrow}</div><h1>{t.title}</h1><p>{t.intro}</p>
  <div class="path-grid">
    <a href={`${base}/learn/first-song-workflow`}><span>01</span><h2>{t.startPath}</h2><p>{t.startPathText}</p></a>
    <a href="#improve"><span>02</span><h2>{t.improvePath}</h2><p>{t.improvePathText}</p></a>
  </div>
</section>
<section class="shell lesson-section" id="start">
  <div class="section-head"><div><div class="eyebrow">{t.start}</div><h2>{t.startPath}</h2></div><p>{t.startIntro}</p></div>
  <div class="lesson-list">{startItems.map(x=><a class="lesson-row" href={`${base}/learn/${x.slug}`}><span>{x.number}</span><div><h3>{x.title}</h3><p>{x.text}</p><strong>{t.read}</strong></div></a>)}</div>
</section>
<section class="shell lesson-section" id="improve">
  <div class="section-head"><div><div class="eyebrow">{t.improve}</div><h2>{t.improvePath}</h2></div><p>{t.improveIntro}</p></div>
  <div class="lesson-list">{improveItems.map(x=><a class="lesson-row" href={`${base}/learn/${x.slug}`}><span>{x.number}</span><div><h3>{x.title}</h3><p>{x.text}</p><strong>{t.read}</strong></div></a>)}</div>
</section>
<section class="shell lesson-section" id="tools-and-release">
  <div class="section-head"><div><div class="eyebrow">{t.tools}</div><h2>{t.toolsHeading}</h2></div><p>{t.toolsIntro}</p></div>
  <div class="lesson-list">{toolItems.map(x=><a class="lesson-row" href={`${base}/learn/${x.slug}`}><span>{x.number}</span><div><h3>{x.title}</h3><p>{x.text}</p><strong>{t.read}</strong></div></a>)}</div>
</section>
<section class="shell tools-strip"><div><div class="eyebrow">{t.toolBox}</div><p>{t.toolText}</p></div><div><a class="pill primary" href={`${base}/tools/song-studio`}>{t.studio}</a><a class="pill" href={`${base}/tools/prompt-builder`}>{t.prompt}</a></div></section>
<style>
.school-hero{padding:72px 0 54px}.school-hero>h1{font-size:clamp(3.3rem,8vw,7rem);line-height:.9;letter-spacing:-.065em;margin:14px 0 22px;max-width:1050px}.school-hero>p{font-size:1.15rem;color:var(--muted);max-width:800px;line-height:1.65}.path-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:34px}.path-grid>a{border:1px solid var(--line);border-radius:24px;padding:24px;background:#09100c}.path-grid>a:hover{border-color:#345b40}.path-grid span,.lesson-row>span{font:.7rem ui-monospace,monospace;color:var(--green);letter-spacing:.14em}.path-grid h2{font-size:1.65rem;margin:10px 0 7px}.path-grid p{margin:0;color:var(--muted)}.lesson-section{padding:64px 0}.section-head{display:grid;grid-template-columns:1fr minmax(260px,480px);gap:40px;align-items:end;margin-bottom:20px}.section-head h2{font-size:clamp(2rem,4vw,3.7rem);line-height:.98;letter-spacing:-.045em;margin:9px 0 0}.section-head>p{color:var(--muted);line-height:1.65;margin:0}.lesson-list{border-top:1px solid var(--line)}.lesson-row{display:grid;grid-template-columns:54px 1fr;gap:17px;padding:22px 0;border-bottom:1px solid var(--line)}.lesson-row h3{font-size:1.14rem;margin:0 0 6px}.lesson-row p{color:var(--muted);margin:0;max-width:850px;line-height:1.55}.lesson-row strong{display:inline-block;color:#6f9b7d;font-size:.8rem;margin-top:8px}.lesson-row:hover h3,.lesson-row:hover strong{color:var(--green)}.tools-strip{margin:16px auto 82px;border:1px solid rgba(102,255,140,.18);background:#09110c;border-radius:24px;padding:25px;display:grid;grid-template-columns:1fr auto;align-items:center;gap:24px}.tools-strip p{color:var(--muted);max-width:690px;margin:8px 0 0}.tools-strip>div:last-child{display:flex;gap:9px;flex-wrap:wrap}@media(max-width:780px){.school-hero{padding-top:46px}.path-grid,.section-head,.tools-strip{grid-template-columns:1fr}.lesson-section{padding:50px 0}.section-head{gap:14px}.lesson-row{grid-template-columns:40px 1fr}.tools-strip>div:last-child{justify-content:flex-start}}
</style>