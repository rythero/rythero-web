---
const { lesson, lang = 'en' } = Astro.props;
const locale = ['en', 'es', 'pt-br'].includes(lang) ? lang : 'en';
const t = lesson[locale];
const base = locale === 'en' ? '' : `/${locale}`;
const labels = {
  en: { quick: 'Quick answer', takeaway: 'Use this in your next generation', back: 'All lessons', studio: 'Open Rythero Studio', prompt: 'Open Prompt Builder', updated: 'Updated' },
  es: { quick: 'Respuesta rápida', takeaway: 'Úsalo en tu próxima generación', back: 'Todas las lecciones', studio: 'Abrir Rythero Studio', prompt: 'Abrir Generador de prompts', updated: 'Actualizado' },
  'pt-br': { quick: 'Resposta rápida', takeaway: 'Use na sua próxima geração', back: 'Todas as aulas', studio: 'Abrir Rythero Studio', prompt: 'Abrir Gerador de prompts', updated: 'Atualizado' }
}[locale];
---
<article class="shell practical-page">
  <header class="hero">
    <div class="eyebrow">{t.eyebrow}</div>
    <h1>{t.title}</h1>
    <p class="dek">{t.intro}</p>
  </header>

  <section class="quick-card" aria-labelledby="quick-title">
    <div class="eyebrow" id="quick-title">{labels.quick}</div>
    <p>{t.quick}</p>
  </section>

  <div class="body">
    {t.sections.map((section) => (
      <section class="lesson-section">
        <h2>{section.title}</h2>
        {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
        {section.example && (
          <div class="example-grid" aria-label="Example comparison">
            <div class="example weak"><span>{locale === 'es' ? 'Menos útil' : locale === 'pt-br' ? 'Menos útil' : 'Less useful'}</span><p>{section.example.weak}</p></div>
            <div class="example strong"><span>{locale === 'es' ? 'Más útil' : locale === 'pt-br' ? 'Mais útil' : 'More useful'}</span><p>{section.example.strong}</p></div>
          </div>
        )}
      </section>
    ))}

    <section class="takeaway">
      <div class="eyebrow">{labels.takeaway}</div>
      <p>{t.takeaway}</p>
    </section>

    <section class="tools" aria-label="Rythero tools">
      <a class="pill primary" href={`${base}/tools/song-studio`}>{labels.studio}</a>
      <a class="pill" href={`${base}/tools/prompt-builder`}>{labels.prompt}</a>
    </section>

    <footer class="article-footer">
      <a href={`${base}/learn`}>← {labels.back}</a>
      <time datetime={lesson.updated}>{labels.updated}: {lesson.updated}</time>
    </footer>
  </div>
</article>

<style>
  .practical-page{max-width:980px;padding-bottom:90px}.hero{padding:72px 0 34px}.hero h1{font-size:clamp(2.8rem,7vw,5.9rem);line-height:.94;letter-spacing:-.055em;margin:14px 0 24px;max-width:960px}.dek{font-size:clamp(1.07rem,2vw,1.3rem);line-height:1.7;color:var(--muted);max-width:820px}.quick-card{border:1px solid rgba(102,255,140,.25);background:linear-gradient(145deg,#0c1810,#08100b);border-radius:24px;padding:25px 28px;margin:10px 0 50px}.quick-card p{font-size:1.12rem;line-height:1.72;margin:12px 0 0}.body{max-width:830px}.lesson-section{padding:34px 0;border-top:1px solid var(--line)}.lesson-section h2{font-size:clamp(1.65rem,3.5vw,2.5rem);line-height:1.08;letter-spacing:-.035em;margin:0 0 18px}.lesson-section p,.lesson-section li{font-size:1.04rem;line-height:1.78;color:#c5cec8}.lesson-section p{margin:0 0 16px}.lesson-section ul{padding-left:22px;margin:16px 0 0}.lesson-section li{margin:8px 0}.example-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:24px}.example{border:1px solid var(--line);border-radius:18px;padding:18px;background:#090f0b}.example span{display:block;font-size:.68rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase;color:#76857c;margin-bottom:8px}.example p{margin:0;font-size:.97rem;line-height:1.65}.example.strong{border-color:#31583d;background:#0a130d}.example.strong span{color:var(--green)}.takeaway{margin:28px 0 34px;padding:24px 26px;border-left:3px solid var(--green);background:#09100c;border-radius:0 18px 18px 0}.takeaway p{font-size:1.12rem;line-height:1.7;margin:10px 0 0}.tools{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 50px}.article-footer{display:flex;justify-content:space-between;gap:18px;padding-top:24px;border-top:1px solid var(--line);color:#829088;font-size:.9rem}.article-footer a{font-weight:750;color:#b6c7bd}.article-footer a:hover{color:var(--green)}@media(max-width:760px){.hero{padding-top:46px}.quick-card{padding:21px}.example-grid{grid-template-columns:1fr}.article-footer{flex-direction:column}}
</style>
