    note:'Final generator prompts stay in English for portability.',
    tabs:['Song Blueprint','Prompt Doctor','Style DNA','Arrangement','Lyrics Blueprint','Export','Audio Analyzer'],
    blueprint:{
      kicker:'01 · SONG BLUEPRINT', title:'Turn a rough idea into a complete production brief.',
