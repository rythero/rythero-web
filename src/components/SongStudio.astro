    intro:'Siete herramientas en un solo espacio. Construye el concepto, repara prompts, define tu sonido, organiza la canción, planifica la letra, exporta y analiza audio — sin registro.',
    note:'Los prompts finales para generadores se mantienen en inglés para mayor compatibilidad.',
    tabs:['Song Blueprint','Prompt Doctor','Style DNA','Arreglo','Lyrics Blueprint','Exportar','Audio Analyzer'],
    blueprint:{
      kicker:'01 · SONG BLUEPRINT', title:'Convierte una idea simple en un plan completo de producción.',
      idea:'¿De qué trata la canción?', ideaPh:'p. ej. echar de menos a alguien pero negarse a volver',
      style:'Estilo / género', stylePh:'p. ej. Afro house, alt-R&B',
      mood:'Estado de ánimo', energy:'Energía', vocal:'Voz principal', duration:'Duración objetivo', language:'Idioma de la letra',
      build:'Crear blueprint', use:'Usar en Exportar', output:'Aquí aparecerá tu blueprint.'
    },
    doctor:{
      kicker:'02 · PROMPT DOCTOR', title:'Detecta instrucciones débiles, vagas o contradictorias.',
      prompt:'Pega un prompt musical', ph:'Pega aquí cualquier prompt…', inspect:'Revisar y reparar',
      output:'Aquí aparecerán los problemas detectados y una versión más limpia.'
    },
    dna:{
      kicker:'03 · STYLE DNA', title:'Define una identidad sonora reutilizable sin copiar artistas.',
      name:'Nombre del ADN', namePh:'p. ej. Night Drive 01', groove:'Groove', texture:'Textura', era:'Época / acabado', harmony:'Armonía', voice:'Carácter de voz', space:'Espacio', energy:'Energía',
      build:'Crear ADN', save:'Guardar ADN', saved:'ADN guardados', output:'Aquí aparecerá tu Style DNA.'
    },
    arrangement:{
      kicker:'04 · MAPA DE ARREGLO', title:'Visualiza dónde debe ocurrir cada sección antes de generar.',
