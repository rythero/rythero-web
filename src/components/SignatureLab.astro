---
const { lang = 'en' } = Astro.props;
const locale = lang === 'es' ? 'es' : lang === 'pt-br' ? 'pt-br' : 'en';
const c = {
  en: {
    eyebrow:'Rythero Signature Lab', title:'Hear the track. Understand the sound.',
    intro:'Use local measurements for technical facts, then AI music analysis for style, instruments, vocals, production and a prompt you can review before using.',
    statusChecking:'Checking AI engine…', localBadge:'LOCAL', aiBadge:'AI MUSIC ANALYSIS',
    modes:['Song → Prompt','Build my sound','Did I get close?'],
    oneTitle:'Upload a track and turn what Rythero hears into a usable prompt.',
    oneText:'The fast local pass measures technical characteristics. The AI pass listens to a short derived excerpt from early, middle and late parts of the track and interprets transferable musical traits.',
    file:'Audio file', focus:'What matters most?', hint:'Optional note', hintPh:'e.g. I care most about the vocal texture and groove',
    focuses:[['balanced','Balanced'],['groove','Groove / tempo'],['vocals','Vocals'],['production','Production'],['structure','Structure / movement']],
    localAction:'Technical analysis only', aiAction:'Analyze music with AI', localEmpty:'Local technical measurements will appear here.', aiEmpty:'AI style, instruments, vocals, production and suggested prompt will appear here.',
    buildTitle:'Find what several references genuinely have in common.',
    buildText:'Choose 2–3 references. Rythero compares short analysis excerpts and separates the shared musical core from the things that differ.', refs:'Reference tracks (2–3)', buildAction:'Build my sound with AI', buildEmpty:'Your shared sound signature will appear here.',
    compareTitle:'Check whether a new result moved toward your saved sound.', compareText:'Upload the new result. Rythero compares it with your saved Signature and suggests concrete changes for the next generation.', result:'New result', compareAction:'Compare with AI', compareEmpty:'Build a sound Signature first, then return here with a new result.',
    review:'What Rythero heard', reviewHint:'Remove anything that sounds wrong. The prompt is rebuilt only from the traits you keep.', rebuild:'Rebuild prompt', prompt:'Suggested prompt from the audio', copied:'Copied', copy:'Copy prompt',
    localNote:'Local mode never uploads audio.', cloudNote:'AI mode sends only a short derived analysis excerpt through Rythero’s secure backend; the full original file is not intentionally stored by Rythero.',
    legalTitle:'Reference use & privacy', legal:'Use audio you are entitled to analyze. AI analysis describes high-level transferable musical traits; it does not recover an original prompt, identify artists, transcribe lyrics, clone voices or reproduce melodies. Results are estimates and confidence matters.', reset:'Reset Lab'
  },
  es: {
    eyebrow:'Rythero Signature Lab', title:'Escucha la canción. Entiende su sonido.',
    intro:'Usa mediciones locales para los datos técnicos y análisis musical con IA para estilo, instrumentos, voz, producción y un prompt que puedes revisar antes de usar.',
    statusChecking:'Comprobando motor IA…', localBadge:'LOCAL', aiBadge:'ANÁLISIS MUSICAL IA',
    modes:['Canción → Prompt','Construir mi sonido','¿Me he acercado?'],
    oneTitle:'Sube una canción y convierte lo que Rythero escucha en un prompt útil.',
    oneText:'El análisis local mide datos técnicos. El análisis IA escucha un fragmento derivado de partes iniciales, centrales y finales y describe rasgos musicales transferibles.',
    file:'Archivo de audio', focus:'¿Qué te importa más?', hint:'Nota opcional', hintPh:'p. ej. me importa especialmente la textura vocal y el groove',
    focuses:[['balanced','Equilibrado'],['groove','Groove / tempo'],['vocals','Voz'],['production','Producción'],['structure','Estructura / evolución']],
    localAction:'Solo análisis técnico', aiAction:'Analizar música con IA', localEmpty:'Aquí aparecerán las mediciones técnicas locales.', aiEmpty:'Aquí aparecerán estilo, instrumentos, voz, producción y el prompt sugerido por la IA.',
    buildTitle:'Descubre qué tienen realmente en común varias referencias.',
    buildText:'Elige 2–3 referencias. Rythero compara fragmentos breves de análisis y separa el núcleo musical compartido de lo que cambia entre ellas.', refs:'Canciones de referencia (2–3)', buildAction:'Construir mi sonido con IA', buildEmpty:'Aquí aparecerá tu firma sonora compartida.',
    compareTitle:'Comprueba si un resultado nuevo se acercó a tu sonido guardado.', compareText:'Sube el nuevo resultado. Rythero lo compara con tu Signature y propone cambios concretos para la siguiente generación.', result:'Nuevo resultado', compareAction:'Comparar con IA', compareEmpty:'Primero construye una Signature sonora y después vuelve con un resultado nuevo.',
    review:'Qué ha oído Rythero', reviewHint:'Quita cualquier rasgo que no encaje. El prompt se reconstruye solo con lo que conserves.', rebuild:'Reconstruir prompt', prompt:'Prompt sugerido desde el audio', copied:'Copiado', copy:'Copiar prompt',
    localNote:'El modo local no sube el audio.', cloudNote:'El modo IA envía únicamente un fragmento breve derivado a través del backend seguro de Rythero; Rythero no almacena intencionadamente el archivo original completo.',
    legalTitle:'Uso de referencias y privacidad', legal:'Usa audio que tengas derecho a analizar. El análisis IA describe rasgos musicales generales y transferibles; no recupera el prompt original, identifica artistas, transcribe letras, clona voces ni reproduce melodías. Los resultados son estimaciones y deben leerse junto a su nivel de confianza.', reset:'Reiniciar Lab'
  },
  'pt-br': {
    eyebrow:'Rythero Signature Lab', title:'Ouça a música. Entenda o som.',
    intro:'Use medições locais para dados técnicos e análise musical com IA para estilo, instrumentos, voz, produção e um prompt que você pode revisar antes de usar.',
    statusChecking:'Verificando motor de IA…', localBadge:'LOCAL', aiBadge:'ANÁLISE MUSICAL IA',
    modes:['Música → Prompt','Construir meu som','Cheguei perto?'],
    oneTitle:'Envie uma música e transforme o que o Rythero ouve em um prompt útil.',
    oneText:'A análise local mede dados técnicos. A análise de IA escuta um trecho derivado de partes iniciais, centrais e finais e descreve características musicais transferíveis.',
    file:'Arquivo de áudio', focus:'O que mais importa?', hint:'Nota opcional', hintPh:'ex. a textura vocal e o groove são o mais importante',
    focuses:[['balanced','Equilibrado'],['groove','Groove / andamento'],['vocals','Voz'],['production','Produção'],['structure','Estrutura / evolução']],
    localAction:'Somente análise técnica', aiAction:'Analisar música com IA', localEmpty:'As medições técnicas locais aparecerão aqui.', aiEmpty:'Estilo, instrumentos, voz, produção e o prompt sugerido pela IA aparecerão aqui.',
    buildTitle:'Descubra o que várias referências realmente têm em comum.',
    buildText:'Escolha 2–3 referências. O Rythero compara pequenos trechos de análise e separa o núcleo musical compartilhado do que muda entre elas.', refs:'Músicas de referência (2–3)', buildAction:'Construir meu som com IA', buildEmpty:'Sua assinatura sonora compartilhada aparecerá aqui.',
    compareTitle:'Confira se um novo resultado se aproximou do som salvo.', compareText:'Envie o novo resultado. O Rythero compara com sua Signature e sugere mudanças concretas para a próxima geração.', result:'Novo resultado', compareAction:'Comparar com IA', compareEmpty:'Crie primeiro uma Signature sonora e depois volte com um novo resultado.',
    review:'O que o Rythero ouviu', reviewHint:'Remova qualquer característica que pareça errada. O prompt é reconstruído apenas com o que você mantiver.', rebuild:'Reconstruir prompt', prompt:'Prompt sugerido a partir do áudio', copied:'Copiado', copy:'Copiar prompt',
    localNote:'O modo local nunca envia o áudio.', cloudNote:'O modo IA envia apenas um pequeno trecho derivado pelo backend seguro do Rythero; o arquivo original completo não é intencionalmente armazenado pelo Rythero.',
    legalTitle:'Uso de referências e privacidade', legal:'Use áudio que você tem direito de analisar. A análise de IA descreve características musicais gerais e transferíveis; não recupera o prompt original, identifica artistas, transcreve letras, clona vozes ou reproduz melodias. Os resultados são estimativas e devem ser lidos junto com o nível de confiança.', reset:'Reiniciar Lab'
  }
}[locale];
---
<section class="shell sig" data-signature-lab data-lang={locale}>
  <div class="eyebrow">{c.eyebrow}</div>
  <h1>{c.title}</h1>
  <p class="sig-intro">{c.intro}</p>
  <div class="engine-row"><span class="engine local">{c.localBadge}</span><span class="engine ai">{c.aiBadge}</span><span id="sig-ai-status" class="engine-status">{c.statusChecking}</span></div>

  <nav class="sig-tabs" aria-label="Signature Lab">
    {c.modes.map((label, i) => <button type="button" class:list={{active:i===0}} data-sig-tab={['single','build','compare'][i]}>{label}</button>)}
  </nav>

  <section class="sig-panel active" data-sig-panel="single">
    <div class="sig-head"><span>01</span><h2>{c.oneTitle}</h2><p>{c.oneText}</p></div>
    <form id="sig-single-form" class="sig-form">
      <label>{c.file}<input id="sig-single-file" type="file" accept="audio/*" required /></label>
      <label>{c.focus}<select id="sig-single-focus">{c.focuses.map(([value,label]) => <option value={value}>{label}</option>)}</select></label>
      <label class="wide">{c.hint}<input id="sig-single-hint" type="text" maxlength="220" placeholder={c.hintPh} /></label>
      <div class="wide sig-actions"><button class="pill" id="sig-single-local" type="button">{c.localAction}</button><button class="pill primary" type="submit">{c.aiAction}</button></div>
    </form>
    <div class="privacy-mini"><span>{c.localNote}</span><span>{c.cloudNote}</span></div>
    <div class="result-grid"><div><div class="result-label">{c.localBadge}</div><div class="sig-output" id="sig-single-local-output">{c.localEmpty}</div></div><div><div class="result-label">{c.aiBadge}</div><div class="sig-output" id="sig-single-ai-output">{c.aiEmpty}</div></div></div>
  </section>

  <section class="sig-panel" data-sig-panel="build" hidden>
    <div class="sig-head"><span>02</span><h2>{c.buildTitle}</h2><p>{c.buildText}</p></div>
    <form id="sig-build-form" class="sig-form one">
      <label>{c.refs}<input id="sig-build-files" type="file" accept="audio/*" multiple required /><small>MP3, WAV, M4A, OGG, FLAC · 2–3</small></label>
      <div class="sig-actions"><button class="pill primary" type="submit">{c.buildAction}</button></div>
    </form>
    <div class="privacy-mini"><span>{c.cloudNote}</span></div>
    <div class="sig-output" id="sig-build-output">{c.buildEmpty}</div>
  </section>

  <section class="sig-panel" data-sig-panel="compare" hidden>
    <div class="sig-head"><span>03</span><h2>{c.compareTitle}</h2><p>{c.compareText}</p></div>
    <form id="sig-compare-form" class="sig-form one">
      <label>{c.result}<input id="sig-compare-file" type="file" accept="audio/*" required /></label>
      <div class="sig-actions"><button class="pill primary" type="submit">{c.compareAction}</button></div>
    </form>
    <div class="privacy-mini"><span>{c.cloudNote}</span></div>
    <div class="sig-output" id="sig-compare-output">{c.compareEmpty}</div>
  </section>

  <template id="sig-review-copy"><span data-review-title>{c.review}</span><span data-review-hint>{c.reviewHint}</span><span data-rebuild>{c.rebuild}</span><span data-prompt>{c.prompt}</span><span data-copy>{c.copy}</span><span data-copied>{c.copied}</span></template>

  <details class="sig-legal"><summary>{c.legalTitle}</summary><p>{c.legal}</p></details>
  <button class="sig-reset" id="sig-reset" type="button">{c.reset}</button>
</section>
<script is:inline src="/signature-lab.js"></script>
<style>
  .sig{padding:68px 0 90px}.sig>h1{font-size:clamp(3rem,7vw,6.2rem);line-height:.92;letter-spacing:-.055em;margin:13px 0 22px;max-width:1050px}.sig-intro{max-width:850px;color:var(--muted);font-size:1.08rem}.engine-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:17px}.engine{border:1px solid #264532;border-radius:999px;padding:6px 9px;font-size:.63rem;font-weight:900;letter-spacing:.1em}.engine.local{color:#8bb99a}.engine.ai{color:#061008;background:var(--green);border-color:var(--green)}.engine-status{font-size:.72rem;color:#7e8d83}.sig-tabs{display:flex;gap:8px;overflow-x:auto;margin:34px 0 10px;padding-bottom:4px;scrollbar-width:none}.sig-tabs button{flex:0 0 auto;border:1px solid var(--line);border-radius:999px;background:#09100c;color:#829087;padding:10px 14px;font-size:.78rem;font-weight:850;cursor:pointer}.sig-tabs button.active{background:var(--green);border-color:var(--green);color:#041108}.sig-panel{border:1px solid var(--line);border-radius:28px;background:linear-gradient(180deg,#09110c,#060a07);padding:26px}.sig-panel[hidden]{display:none}.sig-head{margin-bottom:24px}.sig-head>span{font-size:.68rem;color:var(--green);font-weight:900;letter-spacing:.16em}.sig-head h2{font-size:clamp(1.65rem,3.2vw,2.8rem);line-height:1.02;letter-spacing:-.04em;margin:6px 0 10px}.sig-head p{max-width:800px;margin:0;color:#94a198}.sig-form{display:grid;grid-template-columns:1fr 1fr;gap:13px}.sig-form.one{grid-template-columns:1fr}.sig-form .wide{grid-column:1/-1}.sig-form label{display:flex;flex-direction:column;gap:7px;color:#aeb9b2;font-size:.76rem;font-weight:800}.sig-form input,.sig-form select{width:100%;border:1px solid #203027;background:#0d1510;color:var(--text);border-radius:13px;padding:13px;outline:none}.sig-form input:focus,.sig-form select:focus{border-color:#3a7950;box-shadow:0 0 0 3px rgba(102,255,140,.06)}.sig-form small{color:#68766d;font-weight:500}.sig-actions{display:flex;gap:9px;flex-wrap:wrap}.sig-actions button{cursor:pointer}.privacy-mini{display:flex;gap:12px;flex-wrap:wrap;margin:13px 1px 0;color:#65756b;font-size:.67rem;line-height:1.45}.privacy-mini span:before{content:'•';color:#4b7d59;margin-right:6px}.result-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-top:19px}.result-label{font-size:.62rem;color:#789082;font-weight:900;letter-spacing:.14em;margin:0 0 6px 4px}.sig-output{border:1px solid #1d3025;border-radius:18px;background:#08100b;padding:18px;color:#cad5ce;font-size:.88rem;line-height:1.58;min-height:96px;overflow-wrap:anywhere}.sig-output h3{margin:0 0 9px;font-size:1rem;color:#f0f6f2}.metric-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:12px 0}.metric-card{border:1px solid #1b2c22;border-radius:12px;padding:10px;background:#0b130e}.metric-card small{display:block;color:#728078;font-size:.59rem;text-transform:uppercase;letter-spacing:.09em}.metric-card b{display:block;margin-top:3px;color:#eef5f0}.trait-group{margin-top:15px}.trait-group>strong{display:block;color:#f0f6f2;font-size:.76rem;margin-bottom:7px}.trait-list{display:flex;gap:6px;flex-wrap:wrap}.trait-chip{display:inline-flex;align-items:center;gap:5px;border:1px solid #284333;background:#0d1710;border-radius:999px;padding:6px 8px;color:#b9c7bd;font-size:.7rem}.trait-chip button{border:0;background:none;color:#6f8175;cursor:pointer;padding:0 0 0 2px}.trait-chip button:hover{color:#ffaaa0}.confidence{opacity:.62;font-size:.62rem}.prompt-box{margin-top:16px;border-top:1px solid #1b2d22;padding-top:14px}.prompt-box>strong{display:block;color:var(--green);font-size:.72rem;letter-spacing:.08em}.prompt-text{white-space:pre-wrap;margin-top:7px}.prompt-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:11px}.mini-btn{border:1px solid #294231;border-radius:999px;background:#0d1710;color:#d4dfd7;padding:7px 10px;font-size:.7rem;font-weight:800;cursor:pointer}.uncertainties{margin-top:13px;color:#7f8b84;font-size:.72rem}.sig-legal{margin-top:22px;color:#718078;font-size:.72rem}.sig-legal summary{cursor:pointer;color:#829087}.sig-legal p{max-width:870px;line-height:1.55}.sig-reset{margin-top:16px;border:0;background:none;color:#5f6f65;font-size:.7rem;cursor:pointer;padding:0}.sig-reset:hover{color:#9caf9f}@media(max-width:760px){.sig{padding-top:44px}.sig-panel{padding:18px;border-radius:21px}.sig-form,.result-grid{grid-template-columns:1fr}.sig-form .wide{grid-column:auto}.metric-grid{grid-template-columns:1fr 1fr}.sig-tabs button{padding:9px 11px}}
</style>
