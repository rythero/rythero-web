---
const {
  title = 'Rythero — Create music. Build your sound.',
  description = 'Tools, workflows and practical knowledge for modern music creators.',
  canonical = Astro.url.pathname
} = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site ?? 'https://rythero.com').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#07110d" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/rythero-mark.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rythero" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root{color-scheme:dark;--bg:#050806;--panel:#0a110d;--panel2:#0e1712;--text:#f2f6f3;--muted:#9aa79f;--line:#1b2a21;--green:#66ff8c;--green2:#19d679;--max:1180px}
      *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 70% 0%,rgba(32,220,118,.12),transparent 32%),var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.5}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}.shell{width:min(calc(100% - 32px),var(--max));margin:auto}.nav{display:flex;align-items:center;justify-content:space-between;padding:22px 0}.brand{display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:.16em}.brand img{width:34px;height:34px}.navlinks{display:flex;gap:24px;color:var(--muted);font-size:.95rem}.navlinks a:hover{color:var(--text)}.pill{display:inline-flex;align-items:center;justify-content:center;padding:12px 17px;border-radius:999px;border:1px solid var(--line);background:#0b120e;color:var(--text);font-weight:700}.pill.primary{background:linear-gradient(135deg,var(--green),var(--green2));color:#031006;border-color:transparent}.section{padding:72px 0}.eyebrow{color:var(--green);font-size:.78rem;font-weight:800;letter-spacing:.2em;text-transform:uppercase}.muted{color:var(--muted)}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{border:1px solid var(--line);background:linear-gradient(180deg,rgba(15,24,18,.9),rgba(7,12,9,.92));border-radius:22px;padding:26px}.card h3{margin:0 0 8px;font-size:1.18rem}.footer{border-top:1px solid var(--line);padding:30px 0 44px;color:var(--muted);font-size:.9rem}.footerrow{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}@media(max-width:760px){.navlinks{display:none}.grid3{grid-template-columns:1fr}.section{padding:52px 0}}
    </style>
  </head>
  <body>
    <header class="shell nav">
      <a class="brand" href="/"><img src="/rythero-mark.svg" alt="" /><span>RYTHERO</span></a>
      <nav class="navlinks" aria-label="Primary">
        <a href="/tools/prompt-builder">Tools</a><a href="#learn">Learn</a><a href="#guides">Guides</a>
      </nav>
      <a class="pill" href="/tools/prompt-builder">Start creating</a>
    </header>
    <main><slot /></main>
    <footer class="footer"><div class="shell footerrow"><span>© 2026 Rythero</span><span>Create music. Build your sound.</span></div></footer>
  </body>
</html>
