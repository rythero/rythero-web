---
const {
  lang = 'en',
  title = 'Rythero — Create music. Build your sound.',
  description = 'Rythero is an independent web platform with practical tools and learning resources for AI-assisted music creation.',
  canonical = Astro.url.pathname,
  robots = 'index,follow,max-image-preview:large'
} = Astro.props;

const supported = ['en', 'es', 'pt-br'];
const locale = supported.includes(lang) ? lang : 'en';
const htmlLang = locale === 'pt-br' ? 'pt-BR' : locale;
const siteRoot = Astro.site ?? 'https://rythero.com';
const canonicalUrl = new URL(canonical, siteRoot).toString();
const ogImageUrl = new URL('/rythero-og.jpg', siteRoot).toString();
const logoUrl = new URL('/rythero-mark.svg', siteRoot).toString();

const ui = {
  en: {tools:'Studio',learn:'School',guides:'Prompt Builder',start:'Open Studio',privacy:'Privacy',cookies:'Cookies',choices:'Cookie choices',tagline:'Create music. Build your sound.',nav:'Primary navigation',language:'Language',menu:'Menu',analyticsLabel:'Analytics preferences',analyticsStrong:'Optional analytics.',analyticsText:'Google Analytics stays off until you choose. We use it only to understand usage and improve Rythero.',details:'Cookie details',reject:'Reject',accept:'Accept'},
  es: {tools:'Studio',learn:'Escuela',guides:'Generador de prompts',start:'Abrir Studio',privacy:'Privacidad',cookies:'Cookies',choices:'Preferencias de cookies',tagline:'Crea música. Construye tu sonido.',nav:'Navegación principal',language:'Idioma',menu:'Menú',analyticsLabel:'Preferencias de analítica',analyticsStrong:'Analítica opcional.',analyticsText:'Google Analytics permanece desactivado hasta que elijas. Solo lo usamos para entender el uso y mejorar Rythero.',details:'Detalles de cookies',reject:'Rechazar',accept:'Aceptar'},
  'pt-br': {tools:'Studio',learn:'Escola',guides:'Gerador de prompts',start:'Abrir Studio',privacy:'Privacidade',cookies:'Cookies',choices:'Preferências de cookies',tagline:'Crie música. Construa seu som.',nav:'Navegação principal',language:'Idioma',menu:'Menu',analyticsLabel:'Preferências de análise',analyticsStrong:'Análise opcional.',analyticsText:'O Google Analytics permanece desativado até você escolher. Usamos apenas para entender o uso e melhorar o Rythero.',details:'Detalhes de cookies',reject:'Rejeitar',accept:'Aceitar'}
}[locale];
const currentPath = Astro.url.pathname;
const basePath = currentPath.replace(/^\/(es|pt-br)(?=\/|$)/, '') || '/';
const localize = (code, path = basePath) => { const cleanPath=path.startsWith('/')?path:`/${path}`; if(code==='en')return cleanPath||'/'; return cleanPath==='/'?`/${code}/`:`/${code}${cleanPath}`; };
const isNotFound = currentPath === '/404' || currentPath === '/404/';
const languagePath = (code) => isNotFound ? (code === 'en' ? '/' : `/${code}/`) : localize(code);
const homePath=localize(locale,'/'), toolPath=localize(locale,'/tools/song-studio'), privacyPath=localize(locale,'/privacy'), cookiesPath=localize(locale,'/cookies'), learnPath=localize(locale,'/learn'), guidesPath=localize(locale,'/tools/prompt-builder');
const alternateUrls={en:new URL(languagePath('en'),siteRoot).toString(),es:new URL(languagePath('es'),siteRoot).toString(),'pt-br':new URL(languagePath('pt-br'),siteRoot).toString()};
const ogLocale=locale==='es'?'es_ES':locale==='pt-br'?'pt_BR':'en_US';
const graph={'@context':'https://schema.org','@graph':[{'@type':'Organization','@id':'https://rythero.com/#organization',name:'Rythero',url:'https://rythero.com/',logo:{'@type':'ImageObject',url:logoUrl},description:'Rythero is an independent web platform for AI-assisted music creation, song planning, prompt building and creator education.'},{'@type':'WebSite','@id':'https://rythero.com/#website',url:'https://rythero.com/',name:'Rythero',description:'Practical tools and learning resources for AI-assisted music creation.',publisher:{'@id':'https://rythero.com/#organization'},inLanguage:['en','es','pt-BR']} ]};
const flags = locale==='en' ? [{code:'es',icon:'🇪🇸',label:'Español'},{code:'pt-br',icon:'🇧🇷',label:'Português do Brasil'}] : locale==='es' ? [{code:'en',icon:'🇺🇸',label:'English'},{code:'pt-br',icon:'🇧🇷',label:'Português do Brasil'}] : [{code:'en',icon:'🇺🇸',label:'English'},{code:'es',icon:'🇪🇸',label:'Español'}];
---
<!doctype html><html lang={htmlLang}><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#07110d"/><meta name="description" content={description}/><meta name="robots" content={robots}/>
<link rel="canonical" href={canonicalUrl}/><link rel="alternate" hreflang="en" href={alternateUrls.en}/><link rel="alternate" hreflang="es" href={alternateUrls.es}/><link rel="alternate" hreflang="pt-BR" href={alternateUrls['pt-br']}/><link rel="alternate" hreflang="x-default" href={alternateUrls.en}/><link rel="icon" href="/rythero-mark.svg" type="image/svg+xml"/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="Rythero"/><meta property="og:locale" content={ogLocale}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonicalUrl}/><meta property="og:image" content={ogImageUrl}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Rythero — Create music. Build your sound."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImageUrl}/>
<script type="application/ld+json" set:html={JSON.stringify(graph)}></script><title>{title}</title>
<style is:global>
:root{color-scheme:dark;--bg:#050806;--panel:#0a110d;--text:#f2f6f3;--muted:#9aa79f;--line:#1b2a21;--green:#66ff8c;--green2:#19d679;--max:1180px}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;line-height:1.5}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:2px solid var(--green);outline-offset:3px}.shell{width:min(calc(100% - 32px),var(--max));margin:auto}.nav{display:flex;align-items:center;justify-content:space-between;padding:22px 0;gap:20px}.brand{display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:.16em}.brand img{width:34px;height:34px}.navlinks{display:flex;gap:24px;color:var(--muted);font-size:.95rem}.nav-actions{display:flex;align-items:center;gap:10px}.mobile-menu{display:none;position:relative}.mobile-menu summary{display:grid;place-items:center;width:36px;height:36px;border:1px solid var(--line);border-radius:999px;background:#08100b;cursor:pointer;list-style:none}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu[open] summary{border-color:#31583d;background:#0d1710}.mobile-menu-icon{display:grid;gap:4px;width:14px}.mobile-menu-icon i{display:block;height:1.5px;border-radius:999px;background:#c7d2cb}.mobile-menu-panel{position:absolute;right:0;top:calc(100% + 10px);z-index:60;display:grid;min-width:210px;padding:8px;border:1px solid #24372c;border-radius:16px;background:#08100b;box-shadow:0 16px 40px rgba(0,0,0,.38)}.mobile-menu-panel a{padding:11px 12px;border-radius:10px;color:#dce5df;font-size:.9rem;font-weight:720}.mobile-menu-panel a:hover,.mobile-menu-panel a:focus-visible{background:#102018;color:#f4fff7}.language-control{display:flex;flex-direction:column;align-items:center;gap:3px}.lang-switch{display:inline-flex;gap:3px;padding:4px;border:1px solid var(--line);background:#08100b;border-radius:999px}.lang-switch a{display:grid;place-items:center;min-width:34px;height:30px;padding:0 8px;border-radius:999px;color:#89968e;font-size:.7rem;font-weight:850;letter-spacing:.08em}.lang-switch a.active{color:#041108;background:var(--green)}.lang-flags{display:flex;justify-content:center;gap:8px;height:22px}.lang-flags a{display:grid;place-items:center;width:30px;height:22px;font-size:16px;line-height:1;border-radius:4px;opacity:1;filter:saturate(1.08) brightness(1.12);text-shadow:0 0 1px rgba(255,255,255,.18)}.lang-flags a:hover,.lang-flags a:focus-visible{opacity:1;filter:saturate(1.14) brightness(1.18);outline:1px solid var(--green);outline-offset:1px}.pill{display:inline-flex;align-items:center;justify-content:center;padding:12px 17px;border-radius:999px;border:1px solid var(--line);background:#0b120e;font-weight:700}.pill.primary{background:linear-gradient(135deg,var(--green),var(--green2));color:#031006;border-color:transparent}.section{padding:72px 0}.eyebrow{color:var(--green);font-size:.78rem;font-weight:800;letter-spacing:.2em;text-transform:uppercase}.muted{color:var(--muted)}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{border:1px solid var(--line);background:#0a110d;border-radius:22px;padding:26px}.footer{border-top:1px solid var(--line);padding:30px 0;color:var(--muted);font-size:.9rem}.footerrow{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.footer-links{display:flex;gap:10px;flex-wrap:wrap}.footer-links button{border:0;background:none;color:var(--muted);padding:0}.consent{position:fixed;left:50%;bottom:18px;z-index:1000;width:min(calc(100% - 24px),690px);transform:translateX(-50%);display:none;gap:16px;padding:13px;border:1px solid rgba(102,255,140,.2);border-radius:16px;background:#07100b}.consent.show{display:flex}.consent-copy{flex:1;color:#a9b5ad;font-size:.82rem}.consent-actions{display:flex;gap:8px}.consent-btn{min-width:100px;border:1px solid #3d5545;border-radius:999px;padding:9px 14px;background:#0c1510;color:#eef5f0;font-weight:750}@media(max-width:860px){.navlinks{display:none}.mobile-menu{display:block}.nav-actions>.pill{display:none}.grid3{grid-template-columns:1fr}.section{padding:52px 0}.lang-switch a{min-width:31px;height:29px}.consent{flex-direction:column}.consent-btn{flex:1}}@media(max-width:390px){.nav{gap:10px}.nav-actions{gap:6px}.brand{letter-spacing:.1em}.brand img{width:31px;height:31px}.lang-switch a{min-width:29px;padding:0 6px;font-size:.65rem}}
</style></head><body>
<header class="shell nav"><a class="brand" href={homePath} aria-label="Rythero home"><img src="/rythero-mark.svg" alt="" width="34" height="34"/><span>RYTHERO</span></a><nav class="navlinks" aria-label={ui.nav}><a href={toolPath}>{ui.tools}</a><a href={learnPath}>{ui.learn}</a><a href={guidesPath}>{ui.guides}</a></nav><div class="nav-actions"><details class="mobile-menu"><summary aria-label={ui.menu} title={ui.menu}><span class="mobile-menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></summary><nav class="mobile-menu-panel" aria-label={ui.nav}><a href={toolPath}>{ui.tools}</a><a href={learnPath}>{ui.learn}</a><a href={guidesPath}>{ui.guides}</a></nav></details><div class="language-control"><nav class="lang-switch" aria-label={ui.language}><a class:list={{active:locale==='en'}} href={languagePath('en')} lang="en" hreflang="en" aria-current={locale==='en'?'page':undefined}>EN</a><a class:list={{active:locale==='es'}} href={languagePath('es')} lang="es" hreflang="es" aria-current={locale==='es'?'page':undefined}>ES</a><a class:list={{active:locale==='pt-br'}} href={languagePath('pt-br')} lang="pt-BR" hreflang="pt-BR" aria-current={locale==='pt-br'?'page':undefined}>PT</a></nav><div class="lang-flags" aria-label="Alternative languages">{flags.map(f=><a href={languagePath(f.code)} hreflang={f.code==='pt-br'?'pt-BR':f.code} lang={f.code==='pt-br'?'pt-BR':f.code} aria-label={f.label} title={f.label}>{f.icon}</a>)}</div></div><a class="pill" href={toolPath}>{ui.start}</a></div></header><main><slot /></main>
<footer class="footer"><div class="shell"><div class="footerrow"><span>© 2026 Rythero</span><span class="footer-links"><a href={privacyPath}>{ui.privacy}</a><span>·</span><a href={cookiesPath}>{ui.cookies}</a><span>·</span><button type="button" id="cookie-choices">{ui.choices}</button></span><span>{ui.tagline}</span></div></div></footer>
<div id="consent-banner" class="consent" role="dialog" aria-label={ui.analyticsLabel}><div class="consent-copy"><strong>{ui.analyticsStrong}</strong> {ui.analyticsText} <a href={cookiesPath}>{ui.details}</a></div><div class="consent-actions"><button class="consent-btn" type="button" data-consent="reject">{ui.reject}</button><button class="consent-btn" type="button" data-consent="accept">{ui.accept}</button></div></div>
<script is:inline>(()=>{const key='rythero-consent-v2',id='G-7K1ENQ4HTZ',b=document.getElementById('consent-banner');function ga(){if(document.getElementById('rythero-ga'))return;let s=document.createElement('script');s.id='rythero-ga';s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+id;document.head.appendChild(s);window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config',id,{anonymize_ip:true})}function set(v){localStorage.setItem(key,v);b?.classList.remove('show');if(v==='accept')ga()}let v=localStorage.getItem(key);if(v==='accept')ga();else if(!v)b?.classList.add('show');document.querySelectorAll('[data-consent]').forEach(x=>x.addEventListener('click',()=>set(x.dataset.consent)));document.getElementById('cookie-choices')?.addEventListener('click',()=>b?.classList.add('show'))})();</script></body></html>