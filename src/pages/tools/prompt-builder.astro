---
import Base from '../../layouts/Base.astro';
---
<Base title="Rythero Prompt Builder — Build better music prompts" description="Build a clear, structured music-generation prompt from genre, mood, energy, vocals, instrumentation and song structure." canonical="/tools/prompt-builder">
  <section class="shell tool-hero">
    <div class="eyebrow">Rythero Tool 001</div>
    <h1>Prompt Builder</h1>
    <p class="muted intro">Turn musical decisions into one clean prompt. No sign-up. No filler.</p>
  </section>

  <section class="shell builder-wrap">
    <form id="builder" class="builder">
      <div class="field smart-field" data-selector="genre">
        <label for="genre-search">Genre</label>
        <div class="smart-combobox" data-combobox>
          <div class="smart-chips" data-chips aria-live="polite"></div>
          <input id="genre-search" data-search type="text" autocomplete="off" placeholder="Search or type a style…" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="genre-results" />
          <input data-value name="genre" type="hidden" />
          <div id="genre-results" class="smart-results" data-results role="listbox" hidden></div>
        </div>
        <span class="field-hint">Mix up to 4 styles. Open the field and use More ideas if you are not sure where to start.</span>
      </div>

      <div class="field smart-field" data-selector="mood">
        <label for="mood-search">Mood</label>
        <div class="smart-combobox" data-combobox>
          <div class="smart-chips" data-chips aria-live="polite"></div>
          <input id="mood-search" data-search type="text" autocomplete="off" placeholder="Search or type a mood…" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="mood-results" />
          <input data-value name="mood" type="hidden" />
          <div id="mood-results" class="smart-results" data-results role="listbox" hidden></div>
        </div>
        <span class="field-hint">Choose up to 3 moods. More ideas rotates through useful starting points.</span>
      </div>

      <label class="field">Energy
        <select name="energy">
          <option value="low">Low</option>
          <option value="medium" selected>Medium</option>
          <option value="high">High</option>
          <option value="dynamic / evolving">Dynamic / evolving</option>
        </select>
      </label>

      <label class="field">BPM
        <input name="bpm" inputmode="numeric" pattern="[0-9]*" placeholder="e.g. 118" />
      </label>

      <div class="field smart-field" data-selector="vocal">
        <label for="vocal-search">Vocal</label>
        <div class="smart-combobox" data-combobox>
          <div class="smart-chips" data-chips aria-live="polite"></div>
          <input id="vocal-search" data-search type="text" autocomplete="off" placeholder="Search vocal type or character…" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="vocal-results" />
          <input data-value name="vocal" type="hidden" />
          <div id="vocal-results" class="smart-results" data-results role="listbox" hidden></div>
        </div>
        <span class="field-hint">Start with a voice type, then add character or delivery. Up to 4 choices.</span>
      </div>

      <div class="field smart-field" data-selector="instruments">
        <label for="instruments-search">Instrumentation</label>
        <div class="smart-combobox" data-combobox>
          <div class="smart-chips" data-chips aria-live="polite"></div>
          <input id="instruments-search" data-search type="text" autocomplete="off" placeholder="Search instruments or textures…" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="instruments-results" />
          <input data-value name="instruments" type="hidden" />
          <div id="instruments-results" class="smart-results" data-results role="listbox" hidden></div>
        </div>
        <span class="field-hint">Pick up to 5 elements that should define the arrangement.</span>
      </div>

      <label class="field">Structure
        <select name="structure">
          <option>Hook-first, verse, chorus, verse, breakdown, final chorus</option>
          <option>Verse, pre-chorus, chorus, verse, chorus, bridge, final chorus</option>
          <option>Short intro, verse, hook, verse, hook, outro</option>
          <option>Intro, build, drop, breakdown, second drop, outro</option>
          <option>Custom / flexible structure</option>
        </select>
      </label>

      <div class="field smart-field" data-selector="production">
        <label for="production-search">Production</label>
        <div class="smart-combobox" data-combobox>
          <div class="smart-chips" data-chips aria-live="polite"></div>
          <input id="production-search" data-search type="text" autocomplete="off" placeholder="Search production traits…" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="production-results" />
          <input data-value name="production" type="hidden" />
          <div id="production-results" class="smart-results" data-results role="listbox" hidden></div>
        </div>
        <span class="field-hint">Choose up to 4 traits for mix, space, punch, texture or dynamics.</span>
      </div>

      <div class="field smart-field wide" data-selector="exclude">
        <label for="exclude-search">Exclude</label>
        <div class="smart-combobox" data-combobox>
          <div class="smart-chips" data-chips aria-live="polite"></div>
          <input id="exclude-search" data-search type="text" autocomplete="off" placeholder="Search or type what to avoid…" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="exclude-results" />
          <input data-value name="exclude" type="hidden" />
          <div id="exclude-results" class="smart-results" data-results role="listbox" hidden></div>
        </div>
        <span class="field-hint">Optional. Use this for things you clearly do not want in the result.</span>
      </div>

      <div class="wide controls">
        <button class="pill primary" type="submit">Generate prompt</button>
        <button class="pill" type="reset">Reset</button>
      </div>
    </form>

    <aside class="output-card">
      <div class="output-head"><span>OUTPUT</span><button id="copy" type="button">Copy</button></div>
      <p id="output" class="output">Your prompt will appear here.</p>
      <div id="status" class="status" aria-live="polite"></div>
    </aside>
  </section>

  <script>
    const form = document.querySelector('#builder');
    const output = document.querySelector('#output');
    const copy = document.querySelector('#copy');
    const status = document.querySelector('#status');

    const clean = (value) => String(value || '').trim();
    const normalize = (value) => clean(value).toLocaleLowerCase();

    const selectorConfigs = {
