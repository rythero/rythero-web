---
import Base from '../../layouts/Base.astro';
import PromptBuilder from '../../components/PromptBuilder.astro';

const copy = {
  eyebrow: 'Rythero Tool 001',
  intro: 'Turn musical decisions into one clean prompt. No sign-up. No filler.',
  genre: {
    label: 'Genre',
    placeholder: 'Search or type a style…',
    hint: 'Mix up to 4 styles. Open the field and use More ideas if you are not sure where to start.'
  },
  mood: {
    label: 'Mood',
    placeholder: 'Search or type a mood…',
    hint: 'Choose up to 3 moods. More ideas rotates through useful starting points.'
  },
  energy: { label: 'Energy', low: 'Low', medium: 'Medium', high: 'High', dynamic: 'Dynamic / evolving' },
  bpmPlaceholder: 'e.g. 118',
  vocal: {
    label: 'Vocal',
    placeholder: 'Search vocal type or character…',
    hint: 'Start with a voice type, then add character or delivery. Up to 4 choices.'
  },
  instruments: {
    label: 'Instrumentation',
    placeholder: 'Search instruments or textures…',
    hint: 'Pick up to 5 elements that should define the arrangement.'
  },
  structureLabel: 'Structure',
  structure: [
    { value: 'Hook-first, verse, chorus, verse, breakdown, final chorus', label: 'Hook-first, verse, chorus, verse, breakdown, final chorus' },
    { value: 'Verse, pre-chorus, chorus, verse, chorus, bridge, final chorus', label: 'Verse, pre-chorus, chorus, verse, chorus, bridge, final chorus' },
    { value: 'Short intro, verse, hook, verse, hook, outro', label: 'Short intro, verse, hook, verse, hook, outro' },
    { value: 'Intro, build, drop, breakdown, second drop, outro', label: 'Intro, build, drop, breakdown, second drop, outro' },
    { value: 'Custom / flexible structure', label: 'Custom / flexible structure' }
  ],
  production: {
    label: 'Production',
    placeholder: 'Search production traits…',
    hint: 'Choose up to 4 traits for mix, space, punch, texture or dynamics.'
  },
  exclude: {
    label: 'Exclude',
    placeholder: 'Search or type what to avoid…',
    hint: 'Optional. Use this for things you clearly do not want in the result.'
  },
  generate: 'Generate prompt',
  reset: 'Reset',
  copy: 'Copy',
  outputEmpty: 'Your prompt will appear here.',
  outputNote: ''
};
---
<Base title="Rythero Prompt Builder — Build better music prompts" description="Build a clear, structured music-generation prompt from genre, mood, energy, vocals, instrumentation and song structure." canonical="/tools/prompt-builder">
  <PromptBuilder copy={copy} />
  <script is:inline src="/prompt-builder-ux.js"></script>
</Base>