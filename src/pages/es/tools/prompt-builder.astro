---
import Base from '../../../layouts/Base.astro';
import PromptBuilder from '../../../components/PromptBuilder.astro';

const copy = {
  eyebrow: 'Herramienta Rythero 001',
  intro: 'Convierte decisiones musicales en un prompt claro. Sin registro. Sin relleno.',
  genre: {
    label: 'Género',
    placeholder: 'Busca o escribe un estilo…',
    hint: 'Mezcla hasta 4 estilos. Usa Más ideas si no sabes por dónde empezar.'
  },
  mood: {
    label: 'Estado de ánimo',
    placeholder: 'Busca o escribe un mood…',
    hint: 'Elige hasta 3 estados. Más ideas va mostrando puntos de partida distintos.'
  },
  energy: { label: 'Energía', low: 'Baja', medium: 'Media', high: 'Alta', dynamic: 'Dinámica / evolutiva' },
  bpmPlaceholder: 'p. ej. 118',
  vocal: {
    label: 'Voz',
    placeholder: 'Busca tipo o carácter de voz…',
    hint: 'Empieza por el tipo de voz y añade carácter o interpretación. Hasta 4 opciones.'
  },
  instruments: {
    label: 'Instrumentación',
    placeholder: 'Busca instrumentos o texturas…',
    hint: 'Elige hasta 5 elementos que definan el arreglo.'
  },
  structureLabel: 'Estructura',
  structure: [
    { value: 'Hook-first, verse, chorus, verse, breakdown, final chorus', label: 'Gancho primero, verso, estribillo, verso, breakdown, estribillo final' },
    { value: 'Verse, pre-chorus, chorus, verse, chorus, bridge, final chorus', label: 'Verso, pre-estribillo, estribillo, verso, estribillo, puente, estribillo final' },
    { value: 'Short intro, verse, hook, verse, hook, outro', label: 'Intro corta, verso, gancho, verso, gancho, outro' },
    { value: 'Intro, build, drop, breakdown, second drop, outro', label: 'Intro, subida, drop, breakdown, segundo drop, outro' },
    { value: 'Custom / flexible structure', label: 'Estructura personalizada / flexible' }
  ],
  production: {
    label: 'Producción',
    placeholder: 'Busca rasgos de producción…',
    hint: 'Elige hasta 4 rasgos de mezcla, espacio, pegada, textura o dinámica.'
  },
  exclude: {
    label: 'Excluir',
    placeholder: 'Busca o escribe qué quieres evitar…',
    hint: 'Opcional. Úsalo solo para cosas que claramente no quieres en el resultado.'
  },
  generate: 'Generar prompt',
  reset: 'Reiniciar',
  copy: 'Copiar',
  outputEmpty: 'Tu prompt aparecerá aquí.',
  outputNote: 'El OUTPUT se genera en inglés para mantener la máxima compatibilidad con los generadores musicales.'
};
---
<Base lang="es" title="Rythero Prompt Builder — Crea mejores prompts musicales" description="Construye un prompt musical claro a partir de género, estado de ánimo, energía, voz, instrumentación, estructura y producción." canonical="/es/tools/prompt-builder">
  <PromptBuilder copy={copy} />
  <script is:inline src="/prompt-builder-ux.js"></script>
</Base>