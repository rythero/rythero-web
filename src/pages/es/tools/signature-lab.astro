---
import Base from '../../../layouts/Base.astro';
import SignatureLab from '../../../components/SignatureLab.astro';
---
<Base lang="es" title="Rythero Signature Lab — Análisis musical IA para construir tu sonido" description="Combina mediciones locales con análisis musical por IA para entender estilo, instrumentos, voz y producción, crear un prompt revisable, unir referencias y comparar resultados." canonical="/es/tools/signature-lab">
  <section class="shell local-first-note"><strong>Empieza en local.</strong><span>El análisis técnico y las herramientas de planificación de Rythero funcionan sin IA. Usa el análisis IA solo cuando realmente te aporte algo.</span><a href="/es/learn">Aprende el método →</a></section>
  <SignatureLab lang="es" />
  <style is:global>
    .local-first-note{margin-top:26px;border:1px solid #254331;background:#08100b;border-radius:16px;padding:13px 15px;display:flex;gap:9px;align-items:center;flex-wrap:wrap;color:#aab8af;font-size:.82rem}.local-first-note strong{color:#dff8e6}.local-first-note a{margin-left:auto;color:#66ff8c;font-weight:800}.sig-form input,.sig-form select{background:#f3f1e9!important;color:#132018!important;border-color:#aebbb2!important;color-scheme:light}.sig-form input::placeholder{color:#66736b!important;opacity:1}.sig-form input:focus,.sig-form select:focus{background:#fffef9!important;border-color:#66ff8c!important;box-shadow:0 0 0 3px rgba(102,255,140,.18)!important}.sig-form input[type="file"]::file-selector-button{border:0;border-radius:9px;background:#163421;color:#eaffef;padding:8px 10px;margin-right:10px;font-weight:800;cursor:pointer}@media(max-width:680px){.local-first-note a{margin-left:0;width:100%}}
  </style>
</Base>
