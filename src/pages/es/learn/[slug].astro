---
import Base from '../../../layouts/Base.astro';
import PracticalLessonArticle from '../../../components/PracticalLessonArticle.astro';
import { practicalLessons } from '../../../data/practicalLessons.js';
import { advancedLessons } from '../../../data/advancedLessons.js';
import { platformGuides } from '../../../data/platformGuides.js';

const lessonMap = { ...practicalLessons, ...advancedLessons, ...platformGuides };
const lessonSlugs = Object.keys(lessonMap);

export function getStaticPaths() {
  return lessonSlugs.map((slug) => ({ params: { slug }, props: { lesson: lessonMap[slug], slug } }));
}

const { lesson, slug } = Astro.props;
const t = lesson.es;
---
<Base lang="es" title={`${t.title} | Rythero`} description={t.description} canonical={`/es/learn/${slug}`}>
  <PracticalLessonArticle lesson={lesson} lang="es" />
</Base>
