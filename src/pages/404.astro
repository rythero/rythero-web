---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Rythero" description="The page you requested could not be found." canonical="/404">
  <section class="shell" style="padding:120px 0 160px;max-width:760px">
    <div class="eyebrow">404</div>
    <h1 style="font-size:clamp(3rem,8vw,6rem);letter-spacing:-.05em;line-height:.95;margin:14px 0 22px">That beat went missing.</h1>
    <p class="muted" style="font-size:1.15rem">The page you’re looking for isn’t here.</p>
    <p><a class="pill primary" href="/">Back to Rythero</a></p>
  </section>
</Base>
