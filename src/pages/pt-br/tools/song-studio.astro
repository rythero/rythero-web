---
import Base from '../../../layouts/Base.astro';
import SongStudio from '../../../components/SongStudio.astro';
---
<Base lang="pt-br" title="Rythero Studio — Da ideia a um plano pronto para criar" description="Sete ferramentas práticas para transformar uma ideia em um plano musical: plano da música, correção de prompts, DNA de estilo, arranjo, letra, exportação e análise local de áudio." canonical="/pt-br/tools/song-studio">
  <SongStudio lang="pt-br" />
  <style is:global>
    .studio-form input,.studio-form select,.studio-form textarea{background:#f3f1e9!important;color:#132018!important;border-color:#aebbb2!important;color-scheme:light}.studio-form input::placeholder,.studio-form textarea::placeholder{color:#66736b!important;opacity:1}.studio-form input:focus,.studio-form select:focus,.studio-form textarea:focus{background:#fffef9!important;border-color:#66ff8c!important;box-shadow:0 0 0 3px rgba(102,255,140,.18)!important}.studio-form input[type="file"]::file-selector-button{border:0;border-radius:9px;background:#163421;color:#eaffef;padding:8px 10px;margin-right:10px;font-weight:800;cursor:pointer}
  </style>
</Base>
