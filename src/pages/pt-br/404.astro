---
import Base from '../../layouts/Base.astro';
---
<Base lang="pt-br" title="Página não encontrada — Rythero" description="A página solicitada não foi encontrada." canonical="/pt-br/404" robots="noindex,follow">
  <section class="shell" style="padding:120px 0 160px;max-width:760px">
    <div class="eyebrow">404</div>
    <h1 style="font-size:clamp(3rem,8vw,6rem);letter-spacing:-.05em;line-height:.95;margin:14px 0 22px">Essa batida se perdeu.</h1>
    <p class="muted" style="font-size:1.15rem">A página que você procura não está aqui.</p>
    <p><a class="pill primary" href="/pt-br/">Voltar ao Rythero</a></p>
  </section>
</Base>
